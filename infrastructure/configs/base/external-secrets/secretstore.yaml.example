# Generic template for a per-cluster ClusterSecretStore.
# This is NOT wired into any kustomization.yaml — copy it into a
# <cluster>/external-secrets/ overlay, fill in the placeholders, and
# add the matching auth-credentials Secret (SOPS-encrypted) alongside it.
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: <cluster>-secretstore
spec:
  provider:
    infisical:
      hostAPI: https://app.infisical.com
      auth:
        universalAuthCredentials:
          clientId:
            key: clientId
            namespace: external-secrets
            name: auth-credentials
          clientSecret:
            key: clientSecret
            namespace: external-secrets
            name: auth-credentials
      secretsScope:
        projectSlug: <infisical-project-slug>
        environmentSlug: <infisical-environment-slug>
        secretsPath: /
        recursive: true
